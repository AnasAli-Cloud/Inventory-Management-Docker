# ==============================================================
# .env.example — Example Environment Configuration
# ==============================================================
# Copy this file to .env and adjust values as needed:
# cp .env.example .env
# ==============================================================

# Flask application secret key (used for sessions and flash messages)
SECRET_KEY=change-this-to-a-secure-random-secret-key

# MySQL connection settings
# In Docker Compose, DB_HOST is "db" (matching the MySQL service name)
DB_HOST=db
DB_PORT=3306

# Database name
DB_NAME=inventory_db

# Application-level MySQL user (non-root)
DB_USER=inventory_user
DB_PASSWORD=inventory_secret

# MySQL root password
DB_ROOT_PASSWORD=mysql_root_password_2024
